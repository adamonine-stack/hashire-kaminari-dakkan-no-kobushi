[resource]
script = ExtResource("1_stage")
stage_number = 5
stage_name = "影のジャブマスター"
enemy_definition = ExtResource("2_enemy")
intro_text = "長いリーチと素早いジャブに注意。踏み込みに合わせたカウンターを狙う。"
player_dialogue = "間合いを詰めて、あのジャブを封じる。"
enemy_dialogue = "長いリーチが武器だ。踏み込んだ瞬間を打つ。"
player_dialogues = {
"player_01_akky": "フェイントに惑わされず、ジャブの外から攻める！",
"player_02_gou": "遠い間合いを崩して、一気に決める！",
"player_03_seiya": "リーチの差は踏み込むタイミングで越える。"
}
enemy_dialogues = {
"player_01_akky": "速いジャブで、近づく隙は与えない。",
"player_02_gou": "踏み込んだところを一発で止める。",
"player_03_seiya": "距離を支配する。それが俺の戦い方だ。"
}
backdrop_id = &"island_pier"
