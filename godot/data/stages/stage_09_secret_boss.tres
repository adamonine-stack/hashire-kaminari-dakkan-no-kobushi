"player_01_akky": "まだ終わってないなら、最後までやるだけだ！",
"player_02_gou": "上等だ。最後の一人までまとめて来い！",
"player_03_seiya": "レオンの先にもう一人……これが本当の最後か。"
}
enemy_dialogues = {
"player_01_akky": "その真っ直ぐさが、どこまで通じるか見せてもらおう。",
"player_02_gou": "その力、最後の門を越えられるか試してやる。",
"player_03_seiya": "気づくのが遅かったな。ここから先は読み切れない。"
}
